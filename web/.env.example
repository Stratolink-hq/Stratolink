NEXT_PUBLIC_MAPBOX_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Use the exact deployed origin, without a trailing slash.
SITE_URL=http://127.0.0.1:4173
# Optional exact local or preview origins, comma-separated.
AUTH_ALLOWED_ORIGINS=
# In production, enable only after strict ingress and raw-data cutover are verified.
COMMUNITY_REGISTRATION_ENABLED=false
# Approved organizers' Supabase user UUIDs, comma-separated.
PAYLOAD_STAFF_USER_IDS=
# Independent 32-byte random secret encoded as base64url for claim cookies.
PAYLOAD_CLAIM_COOKIE_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVER_KEY is accepted as an alternative server key name.
SUPABASE_SERVER_KEY=
BLOB_READ_WRITE_TOKEN=
TTN_WEBHOOK_SECRET=
# Fine-grained GitHub token (Contents: read & write on Stratolink-hq/Stratolink)
# used by the TTN webhook to fire the per-fix forecast recompute
# (repository_dispatch "new-fix" → .github/workflows/forecast-recompute.yml).
# Optional: without it no recompute is dispatched and the webhook is unaffected.
GITHUB_DISPATCH_TOKEN=
# Repository that receives the dispatch (default Stratolink-hq/Stratolink).
GITHUB_DISPATCH_REPO=
