{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "lib/wind/**/*.ts",
    "lib/devices/**/*.ts",
    "lib/telemetry/fetchMergedTelemetry.ts",
    "lib/telemetry/missionWindow.ts",
    "lib/supabase.ts",
    "scripts/compute_forecasts.ts",
    "scripts/forecast_local.ts",
    "scripts/inspect_cube.ts",
    "scripts/plan_forecasts.ts",
    "scripts/recompute_forecast.ts"
  ]
}
